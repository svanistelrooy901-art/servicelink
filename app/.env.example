# Local demonstration; no network calls, no real accounts or payments.
VITE_DATA_BACKEND=local
# Set all three only for a NEW, independent Service Link Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SL_PROJECT_REF=

# Enable only after the independent Worker + SQL staging APIs are configured.
VITE_SL_BOOKINGS_ENABLED=false
VITE_SL_MEDIA_ENABLED=false
